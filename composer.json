{
  "name": "spiral/temporal-bridge",
  "description": "Temporal integration package for Spiral Framework",
  "keywords": [
    "spiral",
    "spiral-framework",
    "php",
    "workflow",
    "temporal"
  ],
  "homepage": "https://spiral.dev",
  "support": {
    "issues": "https://github.com/spiral/temporal-bridge/issues",
    "source": "https://github.com/spiral/temporal-bridge",
    "docs": "https://spiral.dev/docs",
    "chat": "https://discord.gg/V6EK4he"
  },
  "license": "MIT",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/spiral"
    }
  ],
  "authors": [
    {
      "name": "Anton Titov (wolfy-j)",
      "email": "wolfy-j@spiralscout.com"
    },
    {
      "name": "Pavel Buchnev (butschster)",
      "email": "pavel.buchnev@spiralscout.com"
    },
    {
      "name": "Aleksei Gagarin (roxblnfk)",
      "email": "alexey.gagarin@spiralscout.com"
    },
    {
      "name": "Maksim Smakouz (msmakouz)",
      "email": "maksim.smakouz@spiralscout.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "spiral/attributes": "^3.1.8",
    "spiral/boot": "^3.18",
    "spiral/core": "^3.18",
    "spiral/roadrunner-bridge": "^5.0",
    "spiral/scaffolder": "^3.18",
    "spiral/tokenizer": "^3.18",
    "temporal/sdk": "^2.20"
  },
  "require-dev": {
    "bamarni/composer-bin-plugin": "^1.8",
    "llm/skills": "^1.15",
    "mockery/mockery": "^1.6.12",
    "roxblnfk/unpoly": "^1.8",
    "spiral/framework": "^3.18",
    "spiral/dumper": "^3.3.1",
    "testo/bridge-infection": "^0.1.9",
    "testo/bridge-mockery": "^0.1.2",
    "testo/testo": "^0.10.56"
  },
  "autoload": {
    "psr-4": {
      "Spiral\\TemporalBridge\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Spiral\\TemporalBridge\\Tests\\App\\": "tests/app/src",
      "Spiral\\TemporalBridge\\Tests\\": "tests/src"
    }
  },
  "scripts": {
    "cs:diff": "php-cs-fixer fix --dry-run -v --diff --config=tools/code-style/.php-cs-fixer.dist.php",
    "cs:fix": "php-cs-fixer fix -v --config=tools/code-style/.php-cs-fixer.dist.php",
    "infect": [
      "@putenv XDEBUG_MODE=coverage",
      "@putenv GRPC_VERBOSITY=NONE",
      "infection --threads=max --min-msi=80 --min-covered-msi=80"
    ],
    "infect:ci": [
      "@putenv XDEBUG_MODE=coverage",
      "@putenv GRPC_VERBOSITY=NONE",
      "infection --ansi --threads=max --logger-github --show-mutations=0 --min-msi=80 --min-covered-msi=80"
    ],
    "psalm": "psalm -c tools/psalm/psalm.xml",
    "psalm:baseline": "psalm -c tools/psalm/psalm.xml --set-baseline=tools/psalm/psalm-baseline.xml",
    "psalm:ci": "psalm -c tools/psalm/psalm.xml --output-format=github --shepherd --show-info=false --stats --threads=4",
    "test": "testo"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "bamarni/composer-bin-plugin": true,
      "llm/skills": true,
      "spiral/composer-publish-plugin": true
    }
  },
  "extra": {
    "bamarni-bin": {
      "bin-links": true,
      "forward-command": false,
      "target-directory": "tools"
    },
    "spiral": {
      "bootloaders": [
        "Spiral\\TemporalBridge\\Bootloader\\TemporalBridgeBootloader"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
